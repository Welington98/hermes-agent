# API_SERVER_KEY must be at least 8 characters. Generate one with:
#   openssl rand -hex 32
API_SERVER_KEY=changeme-generate-with-openssl-rand-hex-32

# Dashboard is bound to 0.0.0.0 (so it's reachable outside the container),
# which requires an auth provider. Basic auth is the simplest option:
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=changeme
# Random secret so sessions survive container restarts:
#   openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=changeme-generate-with-openssl-rand-hex-32

# Match your host user/group to avoid permission errors on the mounted volume
# (run `id -u` / `id -g` to find your values).
PUID=1000
PGID=1000
